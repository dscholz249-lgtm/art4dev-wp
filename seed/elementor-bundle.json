        {
            "slug": "a4gd-why-art",
            "title": "A4GD — Why Art? (editorial)",
            "type": "container",
            "data": [
                {
                    "id": "4d94be0",
                    "elType": "container",
                    "settings": {
                        "content_width": "full",
                        "padding": {
                            "unit": "px",
                            "top": 0,
                            "right": 0,
                            "bottom": 0,
                            "left": 0,
                            "isLinked": true
                        }
                    },
                    "elements": [
                        {
                            "id": "0a4faa1",
                            "elType": "widget",
                            "widgetType": "html",
                            "settings": {
                                "html": "<section class=\"editorial\">\n      <div class=\"container\">\n        <div class=\"editorial__grid\">\n          <div class=\"in-view\">\n            <span class=\"eyebrow eyebrow--clay\">Why Art?</span>\n            <h2 class=\"editorial__title\" style=\"margin-top:1.5rem;\">\n              Not art as decoration.<br>\n              Art as a <em>catalyst</em>.\n            </h2>\n          </div>\n          <div class=\"editorial__body in-view\">\n            <p>\n              Throughout history, the arts have been one of humanity’s most universal connectors — transcending education levels, socio-political and economic status, age, ethnicity, race, religion, gender, sexual orientation, and culture.\n            </p>\n            <p>\n              At Art4Development.Net, we harness that power with intention: co-creating arts-led and arts-infused programs, and facilitating spaces where people connect, collaborate, and build solutions that matter most to their communities.\n            </p>\n            <div class=\"pull\">\n              From brain development to peacebuilding, urban transformation to economic resilience — the arts nurture individuals, strengthen organizations, and empower communities.\n            </div>\n            <p>\n              Since 2002, we have been connecting artists, development practitioners, researchers, educators, and communities through creative inquiry, participatory programs, and knowledge exchange. We believe lasting, inclusive change happens only when culture sits at the center.\n            </p>\n            <a href=\"pages/our-promise.html\" class=\"link-arrow\" style=\"margin-top:1.5rem;\">Read our promise <span class=\"arrow\">→</span></a>\n          </div>\n        </div>\n      </div>\n    </section>",
                                "_margin": {
                                    "unit": "px",
