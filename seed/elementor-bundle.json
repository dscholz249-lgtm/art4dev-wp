                            "widgetType": "html",
                            "settings": {
                                "html": "<section class=\"promises section\">\n      <div class=\"container\">\n        <div class=\"promises__head in-view\">\n          <h2>\n            Three ways to engage with the work.\n          </h2>\n          <p class=\"lead\" style=\"margin:0;\">\n            From program design to community action to lasting partnership — find the door that fits.\n          </p>\n        </div>\n\n        <div class=\"promises__grid\">\n          <a href=\"pages/consulting.html\" class=\"promise-card in-view\">\n            <div>\n              <span class=\"promise-card__num\">i.</span>\n              <h3>Explore what we do.</h3>\n              <p>Consulting, placemaking, research, and design programs that put arts and culture to work.</p>\n            </div>\n            <span class=\"promise-card__arrow\">What we do <span class=\"arrow\">→</span></span>\n          </a>\n\n          <a href=\"pages/events.html\" class=\"promise-card in-view\">\n            <div>\n              <span class=\"promise-card__num\">ii.</span>\n              <h3>Take action.</h3>\n              <p>Join an initiative, attend an event, or contribute to our global learning community.</p>\n            </div>\n            <span class=\"promise-card__arrow\">Take action <span class=\"arrow\">→</span></span>\n          </a>\n\n          <a href=\"pages/champion.html\" class=\"promise-card in-view\">\n            <div>\n              <span class=\"promise-card__num\">iii.</span>\n              <h3>Champion the work.</h3>\n              <p>Partner with us, donate, or volunteer your time and expertise.</p>\n            </div>\n            <span class=\"promise-card__arrow\">Champion <span class=\"arrow\">→</span></span>\n          </a>\n        </div>\n      </div>\n    </section>",
