                                "html": "<section class=\"section--cream\" style=\"padding-block:5rem;\"><div class=\"container\"><div class=\"donate-panel\">\n          <img src=\"/wp-content/themes/art4dev/assets/logos/logo-mark.svg\" alt=\"\" class=\"donate-panel__mark\">\n          <span class=\"eyebrow eyebrow--center eyebrow--clay\" style=\"display:block;text-align:center;\">Donate to</span>\n          <h3>Arts for Global Development, Inc.</h3>\n          <p>Support programs that apply the arts and culture to challenge and address socio-ecological inequities.</p>\n          <div class=\"donate-panel__btns\">\n            <a href=\"pages/donate-sponsor.html\" class=\"donate-panel__btn-pp\">PayPal</a>\n            <a href=\"pages/donate-sponsor.html\" class=\"donate-panel__btn-venmo\">Venmo</a>\n            <a href=\"pages/donate-sponsor.html\" class=\"btn btn--outline\" style=\"margin-top:0.5rem;\">Donate with debit or credit card</a>\n          </div>\n        </div></div></section>",
